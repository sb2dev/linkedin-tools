# Copy to backend/.env. Every value has a working default, so an empty file also starts the API.

PORT=3100

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=linkedin
DATABASE_PASSWORD=linkedin
DATABASE_NAME=linkedin

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=profiles

# The import and admin endpoints sit behind this account. The password is stored as a bcrypt hash,
# so the plaintext never exists in the process; the hash below is "admin". Replace it with:
#   node -e "console.log(require('bcryptjs').hashSync('newpassword', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$AGcTPfSVwUrW07mgypq1Fu6CejEZPvl2Meg34WpkPw39iya5f7poS

JWT_SECRET=development-only-jwt-secret
JWT_EXPIRES_IN=12h

UPLOAD_MAX_BYTES=33554432
CORS_ORIGINS=http://localhost:5173
